# Copy to .env for local development. The values below are examples, not requirements.
# In Docker Compose the same variables come from the compose file instead.

RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgres://postgres:postgres@localhost:5432/escrow

# Blocks to wait before indexing, logs per request, and the pause between polls.
CONFIRMATIONS=2
BATCH_SIZE=500
POLL_INTERVAL_MS=1000

# Optional. Defaults: 10 and /shared/deployment.json
# HEALTH_MAX_EXTRA_LAG_BLOCKS=10
# DEPLOYMENT_FILE=/shared/deployment.json

# Only for the database tests. Must point at a Postgres you can write to.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/escrow
